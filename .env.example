# Copy to .env for docker compose.
# Released image for deploy/docker-compose.yml (set by `make dist`); ignored by the build compose.
DASHBOARD_IMAGE=ghcr.io/jniltinho/go-dash
DASHBOARD_TAG=latest
# Host IP and port the dashboard is published on (0.0.0.0 = all interfaces).
DASHBOARD_BIND_IP=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_TITLE=Go Dash
DASHBOARD_ADMIN_PASSWORD=change-me-please
DASHBOARD_PUBLIC_URL=
# Sub-path behind a reverse proxy, e.g. /panel/ (default: served at /).
DASHBOARD_BASE_PATH=/
DASHBOARD_DEFAULT_THEME=ocean-light
DASHBOARD_DEFAULT_THEME_STYLE=flat
# Behind an HTTPS reverse proxy (with DASHBOARD_BIND_IP=127.0.0.1): both true.
DASHBOARD_TRUST_PROXY=false
DASHBOARD_COOKIE_SECURE=false
