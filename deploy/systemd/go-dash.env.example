# Settings for the go-dash systemd service (/opt/go-dash/go-dash.env).
# Readable by root and the go-dash group only (0640): it may hold secrets.
# After editing: sudo systemctl restart go-dash
# Every key is listed in docs/README.md ("Configuration").

# IP:port to listen on. ":8080" = all interfaces; "10.0.0.5:9090" = one IP;
# "127.0.0.1:8080" = local only (behind a reverse proxy).
DASHBOARD_ADDR=:8080
DASHBOARD_TITLE=Go Dash
# Own address as users open it (never loaded inside an iframe).
DASHBOARD_PUBLIC_URL=
# Sub-path when nginx publishes it at https://host/panel/ (see docs/install.md, C).
#DASHBOARD_BASE_PATH=/panel/

# Admin password: prefer a bcrypt hash; leave both empty to disable /admin
# (or set it in the database: see docs/install.md).
DASHBOARD_ADMIN_PASSWORD_HASH=
DASHBOARD_ADMIN_PASSWORD=

DASHBOARD_DEFAULT_THEME=ocean-light
DASHBOARD_DEFAULT_THEME_STYLE=flat

# Behind an HTTPS reverse proxy (nginx, Caddy, Traefik):
#DASHBOARD_TRUST_PROXY=true
#DASHBOARD_COOKIE_SECURE=true

# Example menu imported on the first start, while the menu is empty:
#DASHBOARD_SEED=/opt/go-dash/menu.json
